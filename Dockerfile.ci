FROM python:3.12-slim
WORKDIR /srv
COPY requirements.txt requirements-dev.txt ./
RUN pip install --no-cache-dir -r requirements-dev.txt
COPY app app
COPY scripts scripts
COPY tests tests
COPY pyproject.toml .
CMD ["python", "-m", "pytest", "--junitxml=reports/junit.xml", "--cov=app", "--cov=scripts", "--cov-report=xml:reports/coverage.xml", "--cov-report=term-missing", "--cov-fail-under=80"]
